# ==============================
# Base image: CUDA + Ubuntu 22.04
# ==============================
FROM nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04

# ==============================
# Environment
# ==============================
ENV DEBIAN_FRONTEND=noninteractive
ENV CONDA_DIR=/opt/conda
ENV PATH=/opt/conda/bin:/usr/local/bin:$PATH

# Jupyter user (MATCH JupyterHub)
ARG NB_USER=iccbs
ARG NB_UID=1000
ARG NB_GID=100

# ==============================
# System dependencies
# ==============================
RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        ca-certificates \
        build-essential \
        cmake \
        pkg-config \
        python3 \
        python3-pip \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        graphviz \
    && rm -rf /var/lib/apt/lists/*

# ==============================
# Install Miniforge (no ToS issues)
# ==============================
RUN wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p ${CONDA_DIR} && \
    rm /tmp/miniforge.sh && \
    conda config --set always_yes yes --set changeps1 no && \
    conda clean -ya

# ==============================
# Core Python & Jupyter
# ==============================
RUN conda install -y \
        python=3.10 \
        notebook \
        jupyterlab \
        jupyterhub \
        ipykernel && \
    conda clean -ya

# Ensure console scripts exist
RUN pip install --no-cache-dir jupyterhub jupyterlab

# Make jupyterhub-singleuser globally visible
RUN ln -sf /opt/conda/bin/jupyterhub-singleuser /usr/local/bin/jupyterhub-singleuser && \
    chmod +x /opt/conda/bin/jupyterhub-singleuser

# ==============================
# AI / ML Frameworks (GPU)
# ==============================
RUN conda install -y -c pytorch -c nvidia \
        pytorch \
        torchvision \
        torchaudio \
        pytorch-cuda=12.1 && \
    conda clean -ya

RUN pip install --no-cache-dir \
        tensorflow==2.15.* \
        keras \
        lightning \
        torchmetrics \
        scikit-learn \
        xgboost \
        lightgbm

# ==============================
# Bio / Chem AI Libraries
# ==============================
RUN pip install --no-cache-dir \
        biopython \
        rdkit-pypi \
        deepchem \
        openbabel-wheel \
        pymol-open-source \
        mdtraj \
        ase \
        prody

# ==============================
# Protein / Structure AI
# ==============================
RUN pip install --no-cache-dir \
        transformers \
        datasets \
        accelerate \
        fair-esm \
        einops

# ==============================
# Scientific Stack
# ==============================
RUN pip install --no-cache-dir \
        numpy \
        scipy \
        pandas \
        matplotlib \
        seaborn \
        plotly \
        tqdm \
        h5py \
        networkx \
        pyarrow


# ==============================
# Create notebook user
# ==============================
RUN if ! getent group ${NB_GID} >/dev/null; then \
        groupadd -g ${NB_GID} ${NB_USER}; \
    fi && \
    id -u ${NB_UID} >/dev/null 2>&1 || \
        useradd -m -s /bin/bash -N -u ${NB_UID} -g ${NB_GID} ${NB_USER}

# ==============================
# Workspace + permissions
# ==============================
RUN mkdir -p /home/${NB_USER} /workspace /home/${NB_USER}/shared-datasets && \
    chown -R ${NB_UID}:${NB_GID} \
        /home/${NB_USER} \
        /workspace \
        /opt/conda

# ==============================
# Switch to notebook user
# ==============================
USER ${NB_UID}:${NB_GID}
WORKDIR /home/iccbs

# ==============================
# Default command (ignored by JupyterHub)
# ==============================
CMD ["bash"]
