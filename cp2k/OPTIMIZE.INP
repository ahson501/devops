&GLOBAL
  PROJECT bromoaniline
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
#  STRESS_TENSOR ANALYTICAL
  METHOD QS
  &SUBSYS
    &CELL
     ABC 20.000   20.000   20.000
     ALPHA_BETA_GAMMA 90.00  90.00  90.00
     PERIODIC XYZ
    &END CELL
    &TOPOLOGY
     COORD_FILE_FORMAT PDB
     COORD_FILE_NAME 4bromoaniline.pdb
     CONNECTIVITY OFF
     &CENTER_COORDINATES
     &END CENTER_COORDINATES
    &END TOPOLOGY
    &KIND H
      BASIS_SET 6-311G**
      POTENTIAL All
      ELEMENT H
    &END KIND
    &KIND C
      BASIS_SET 6-311G**
      POTENTIAL All
      ELEMENT C
    &END Kind
    &KIND O
      BASIS_SET 6-311G**
      POTENTIAL All
      ELEMENT O
    &END KIND
    &KIND N
      BASIS_SET 6-311G**
      POTENTIAL All
      ELEMENT N
    &END KIND
    &KIND Br
      ELEMENT Br
      BASIS_SET 6-311G**
      POTENTIAL All
    &END KIND
  &END SUBSYS
  &DFT
    LSD T
    BASIS_SET_FILE_NAME ./EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME ./POTENTIAL
    &POISSON
     PERIODIC XYZ
     PSOLVER PERIODIC
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-14
    &END QS
    &MGRID
      CUTOFF [Ry] 600
      REL_CUTOFF [Ry] 60
      PROGRESSION_FACTOR 3
      NGRIDS 4
    &END MGRID
    &SCF
      IGNORE_CONVERGENCE_FAILURE T
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 100
      &OT T
       MINIMIZER DIIS
       PRECONDITIONER FULL_ALL
      &END OT 
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
      &PAIR_POTENTIAL
        TYPE DFTD3
        PARAMETER_FILE_NAME dftd3.dat
        REFERENCE_FUNCTIONAL PBE
        R_CUTOFF [angstrom] 12
      &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
#    &PRINT
#     &E_DENSITY_CUBE
#     &END E_DENSITY_CUBE
#     &V_HARTREE_CUBE
#     &END V_HARTREE_CUBE
#    &END PRINT
  &END DFT
&END FORCE_EVAL
&MOTION
  &GEO_OPT
#    TYPE MINIMIZATION
    MAX_DR    3.0E-03
    MAX_FORCE 2.0E-04
    RMS_DR    1.5E-03
    RMS_FORCE 1.0E-04
    MAX_ITER 1000
    &BFGS
     TRUST_RADIUS [angstrom] 0.1
    &END BFGS
  &END GEO_OPT
&END MOTION
#&EXT_RESTART
# RESTART_FILE_NAME 
#&END EXT_RESTART

