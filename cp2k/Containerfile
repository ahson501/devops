# ==============================
# Base image (CUDA dev)
# ==============================
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/bin:$PATH

ARG NB_USER=iccbs
ARG NB_UID=1000
ARG NB_GID=100

# Fix Ubuntu mirrors
RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list

# ==============================
# System dependencies
# ==============================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gfortran cmake git wget curl ca-certificates \
    pkg-config libtool libtool-bin \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir notebook jupyterlab jupyterhub ipykernel \
    numpy scipy matplotlib ase

# ==============================
# Clone CP2K
# ==============================
WORKDIR /opt
RUN git clone --recursive https://github.com/cp2k/cp2k.git

# ==============================
# Build CP2K Toolchain (NO MPI)
# ==============================
WORKDIR /opt/cp2k/tools/toolchain
RUN ./install_cp2k_toolchain.sh \
    --mpi-mode=no \
    --math-mode=openblas \
    --with-fftw=install \
    --with-libint=install \
    --with-libxc=install \
    -j 2

# ==============================
# 🔥 Build CP2K with CUDA (CRITICAL FIX)
# ==============================
WORKDIR /opt/cp2k

RUN /bin/bash -c "\
    source tools/toolchain/install/setup && \
    export CUDA_HOME=/usr/local/cuda && \
    export PATH=\$CUDA_HOME/bin:\$PATH && \
    export LD_LIBRARY_PATH=\$CUDA_HOME/lib64:\$LD_LIBRARY_PATH && \
    nvcc --version && \
    rm -rf build && \
    mkdir -p build && cd build && \
    cmake .. \
      -DCP2K_USE_MPI=OFF \
      -DCP2K_USE_OPENMP=ON \
      -DCP2K_USE_CUDA=ON \
      -DCP2K_USE_ACCEL=CUDA \
      -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
      -DCMAKE_CUDA_ARCHITECTURES=75 \
      -DCP2K_USE_FFTW=ON \
      -DCP2K_USE_LIBINT=ON \
      -DCP2K_USE_LIBXC=ON \
      -DCMAKE_BUILD_TYPE=Release && \
    make -j2"

# Ensure toolchain env everywhere
RUN echo "source /opt/cp2k/tools/toolchain/install/setup" >> /etc/bash.bashrc

# ==============================
# Paths
# ==============================
ENV PATH="/opt/cp2k/build/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/cp2k/tools/toolchain/install/openblas-0.3.30/lib:/opt/cp2k/tools/toolchain/install/libxc-7.0.0/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# ==============================
# ✅ BEST PRACTICE: examples folder
# ==============================
RUN mkdir -p /opt/cp2k/examples

COPY ana.inp \
     dftd3.dat \
     EMSL_BASIS_SETS \
     GTH_POTENTIALS \
     OPTIMIZE.INP \
     POTENTIAL \
     /opt/cp2k/examples/

# ==============================
# Notebook user
# ==============================
RUN groupadd -g ${NB_GID} ${NB_USER} || true && \
    useradd -m -u ${NB_UID} -g ${NB_GID} -s /bin/bash ${NB_USER} || true

RUN chown -R ${NB_UID}:${NB_GID} /opt/cp2k

# ==============================
# Create convenient launcher
# ==============================
RUN ACTUAL_BIN=$(find /opt/cp2k/build/bin -name "cp2k*" -type f -executable | head -n 1) && \
    ln -sf "$ACTUAL_BIN" /usr/local/bin/cp2k.ssmp && \
    chmod +x /usr/local/bin/cp2k.ssmp

# ============================== # Switch to notebook user # ============================== 
USER ${NB_UID}:${NB_GID} 
WORKDIR /home/iccbs

ENV OMP_NUM_THREADS=8

CMD ["bash"]
