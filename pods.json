{
  "datasource": "Prometheus",
  "fieldConfig": {
    "defaults": {
      "color": {"mode": "thresholds"},
      "unit": "percent",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {"color": "green", "value": null},
          {"color": "yellow", "value": 70},
          {"color": "red", "value": 90}
        ]
      }
    }
  },
  "targets": [
    {
      "expr": "nvidia_gpu_utilization * on (uuid) group_left (pod) kube_pod_labels{namespace='iccbs'}",
      "legendFormat": "{{pod}}",
      "refId": "A"
    }
  ],
  "title": "Jupyter Pod GPU Usage",
  "type": "timeseries"
}
